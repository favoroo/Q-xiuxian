## 通用兜底规则：(正则, 语义档)。只在显式表没有覆盖到的字符上生效。
## 注意顺序：先名词、再数值。数值规则必须避开公式里的乘号（护甲 × 0.08 不是增益）。
const PATTERNS: Array[Dictionary] = [
	# 名词与操作名
	{"re": "「[^」]*」", "s": S.BOLD},
	# 机制名 【...】（选角/图鉴）
	{"re": "【[^】]+】", "s": S.BOLD},
	# 负向限制与惩罚词（选角特性）
	{"re": "无法通过加点提升|加点锁定|无法提升|限制为 3 格|损失 3 点|物价 \\+50%", "s": S.COST},
	# 危险实体
	{"re": "Boss|魔君|魔尊|狂暴", "s": S.COST},
	# 货币
	{"re": "金币", "s": S.COIN},
