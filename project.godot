; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="剑士 (Swordsman)"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/brand/splash_round.png"
config/icon="res://assets/brand/app_icon.png"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

Version="*res://scripts/autoload/Version.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
UpdateManager="*res://scripts/autoload/UpdateManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
GameManager="*res://scripts/autoload/GameManager.gd"

[debug]

gdscript/warnings/enable=true
; 关键正确性警告按 ERROR（2）：存量已清零，新增即阻断加载，防回归
gdscript/warnings/unassigned_variable=2
gdscript/warnings/unassigned_variable_op_assign=2
gdscript/warnings/unreachable_code=2
gdscript/warnings/unreachable_pattern=2
gdscript/warnings/standalone_expression=2
gdscript/warnings/standalone_ternary=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2
; 风格类保持 WARN（1）：不阻断，仅提示
gdscript/warnings/unused_variable=1
gdscript/warnings/unused_parameter=1
gdscript/warnings/unused_signal=1
gdscript/warnings/shadowed_variable=1
gdscript/warnings/confusable_identifier=1
; 静态类型/unsafe 系列暂不启用（存量未全量标注，避免噪声）
gdscript/warnings/untyped_declaration=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/missing_await=0

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://fonts/MiSans-Semibold.woff2"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_projectiles"
2d_physics/layer_5="loot"
2d_physics/layer_6="interactables"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
2d/snap/snap_2d_vertices_to_pixel=true
