; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="剑士 (Swordsman)"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/brand/splash_round.png"
config/icon="res://assets/brand/app_icon.png"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

Version="*res://scripts/autoload/Version.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
UpdateManager="*res://scripts/autoload/UpdateManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
GameManager="*res://scripts/autoload/GameManager.gd"

[debug]

gdscript/warnings/unassigned_variable=2
gdscript/warnings/unassigned_variable_op_assign=2
gdscript/warnings/unreachable_code=2
gdscript/warnings/unreachable_pattern=2
gdscript/warnings/standalone_expression=2
gdscript/warnings/standalone_ternary=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://fonts/MiSans-Semibold.woff2"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_projectiles"
2d_physics/layer_5="loot"
2d_physics/layer_6="interactables"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=30
# 关闭：渲染与物理运行时锁同频（Main._apply_fps_limit 恒 60/60），
# 插值只在「渲染 fps 远高于物理 Hz」时有价值，这里纯属每帧白付快照+插值开销。
common/physics_interpolation=false

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
# 关闭（2026-10-16）：逐顶点 CPU 对齐破坏 canvas 批处理（759 draw call 根因之一），
# 本项目主体是程序化矢量绘制 + 非整像素 squash 缩放，无整像素收益。
2d/snap/snap_2d_vertices_to_pixel=false
viewport/hdr_2d=true
