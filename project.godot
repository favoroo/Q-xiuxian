; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="修仙幸存者"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/brand/app_icon.png"
boot_splash/show_image=true
boot_splash/image="res://assets/brand/splash_logo.png"
boot_splash/bg_color=Color(0.035, 0.05, 0.09, 1)
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

Version="*res://scripts/autoload/Version.gd"
UpdateManager="*res://scripts/autoload/UpdateManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
GameManager="*res://scripts/autoload/GameManager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://fonts/MiSans-Semibold.woff2"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_projectiles"
2d_physics/layer_5="loot"
2d_physics/layer_6="interactables"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.09, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
